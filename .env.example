# ============================================
# 漫剧 AI 制作 - 环境配置模板
# 复制此文件为 .env 后填入真实密钥
# ============================================

# ---- 多模态模型配置 ----
# 主模型：openai / gemini / qwen 三选一或全部
MM_MODEL_PROVIDER=openai

# OpenAI (GPT-4o + DALL-E 3)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# Google Gemini (可选)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 阿里通义 (可选)
DASHSCOPE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- AI 配音配置 ----
# 配音引擎: edge-tts (免费) / openai-tts / fish-audio
TTS_ENGINE=edge-tts

# Edge-TTS 语音 (中文推荐: zh-CN-XiaoxiaoNeural 女声 / zh-CN-YunxiNeural 男声)
TTS_VOICE_MALE=zh-CN-YunxiNeural
TTS_VOICE_FEMALE=zh-CN-XiaoxiaoNeural
TTS_VOICE_NARRATOR=zh-CN-YunxiNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# ---- 视频输出配置 ----
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_FORMAT=mp4

# ---- 输出路径 ----
ARTWORK_DIR=artwork
FRAMES_DIR=frames
AUDIO_DIR=audio
OUTPUT_DIR=output
DATA_DIR=data
